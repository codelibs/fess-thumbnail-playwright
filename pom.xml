<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>fess-thumbnail-playwright</artifactId>
	<packaging>jar</packaging>
	<name>Playwright Thumbnail Generator</name>
	<version>15.9.0-SNAPSHOT</version>
	<scm>
		<connection>scm:git:git@github.com:codelibs/fess-thumbnail-playwright.git</connection>
		<developerConnection>scm:git:git@github.com:codelibs/fess-thumbnail-playwright.git</developerConnection>
		<url>https://github.com/codelibs/fess-thumbnail-playwright</url>
	  <tag>HEAD</tag>
  </scm>
	<parent>
		<groupId>org.codelibs.fess</groupId>
		<artifactId>fess-parent</artifactId>
		<version>15.9.0-SNAPSHOT</version>
		<relativePath />
	</parent>
	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-source-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-javadoc-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>com.mycila</groupId>
				<artifactId>license-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>net.revelc.code.formatter</groupId>
				<artifactId>formatter-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<!-- This jar is installed into WEB-INF/plugin, where nothing resolves its
							     dependencies for it, and the war no longer carries Playwright (it moved
							     out with the Playwright crawler), so the API and its JS driver have to
							     travel inside this jar. fess-crawler-playwright ships the same two
							     artifacts the same way, at the same ${playwright.version} from
							     fess-parent, so a Fess with both plugins installed finds identical
							     classes in two jars and the first one on the class path wins.
							     No relocation: DriverJar looks its driver up by the literal resource
							     name "driver/package", which a relocation would not rewrite.
							     The list is an include list rather than an exclude list because it is
							     short and closed: everything else this module compiles against - fess,
							     corelib, lastaflute, dbflute, slf4j, and gson, which Playwright brings
							     in on its own - is in WEB-INF/lib, which precedes WEB-INF/plugin on
							     every class path Fess builds. -->
							<artifactSet>
								<includes>
									<include>com.microsoft.playwright:playwright</include>
									<include>com.microsoft.playwright:driver</include>
								</includes>
							</artifactSet>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<!-- Fess plugins are distributed through maven.codelibs.org instead of Maven Central.
	     This cannot be inherited from fess-parent: distributionManagement is inherited
	     unconditionally, so declaring it there would also redirect the SNAPSHOT
	     deployments of fess-parent, fess, fess-crawler, fess-crawler-playwright and
	     fess-suggest, which stay on Maven Central. The scpexe transport comes from
	     the wagon-ssh-external build extension inherited from fess-parent. -->
	<distributionManagement>
		<repository>
			<id>codelibs-repo</id>
			<name>CodeLibs Repository</name>
			<url>scpexe://maven.codelibs.org/var/www/maven/release</url>
		</repository>
		<snapshotRepository>
			<id>codelibs-snapshots</id>
			<name>CodeLibs Snapshot Repository</name>
			<url>scpexe://maven.codelibs.org/var/www/maven/snapshot</url>
		</snapshotRepository>
	</distributionManagement>
	<repositories>
		<repository>
			<id>snapshots.central.sonatype.com</id>
			<url>https://central.sonatype.com/repository/maven-snapshots</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>
	<dependencies>
		<dependency>
			<groupId>jakarta.annotation</groupId>
			<artifactId>jakarta.annotation-api</artifactId>
			<version>${jakarta.annotation.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>${jakarta.servlet.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.codelibs</groupId>
			<artifactId>corelib</artifactId>
			<version>${corelib.version}</version>
		</dependency>
		<dependency>
			<groupId>org.lastaflute</groupId>
			<artifactId>lastaflute</artifactId>
			<version>${lastaflute.version}</version>
		</dependency>
		<dependency>
			<groupId>org.dbflute</groupId>
			<artifactId>dbflute-runtime</artifactId>
			<version>${dbflute.version}</version>
		</dependency>
		<dependency>
			<groupId>org.codelibs.fess</groupId>
			<artifactId>fess</artifactId>
			<version>${fess.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.opensearch</groupId>
			<artifactId>opensearch</artifactId>
			<version>${opensearch.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>${slf4j.version}</version>
		</dependency>
		<dependency>
			<groupId>com.microsoft.playwright</groupId>
			<artifactId>playwright</artifactId>
			<version>${playwright.version}</version>
			<exclusions>
				<exclusion>
					<!-- driver-bundle is five Node.js binaries, one per platform, and nothing else:
					     191 MiB, for a thumbnail generator that is not part of the distribution. The
					     JS driver itself lives in com.microsoft.playwright:driver, which stays and
					     is shaded in below. DriverJar reads it as a plain class path resource
					     ("driver/package"), so it survives shading; it only reaches for
					     "driver/<platform>", the binary this exclusion removes, when no Node.js is
					     configured. Fess points it at one through PLAYWRIGHT_NODEJS_PATH, which
					     bin/fess.in.sh sets from bin/fess-setup install nodejs, and the thumbnail
					     job inherits it.
					     NOTE: this split only exists from Playwright 1.62.0. In 1.60 and earlier
					     DriverJar itself lived in driver-bundle, so excluding it there would take
					     the driver away with it. -->
					<groupId>com.microsoft.playwright</groupId>
					<artifactId>driver-bundle</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<!-- Excluded from the compile scope above so it stays out of the plugin jar, and put
			     back here because the tests drive a real browser: without a Node.js binary on the
			     class path DriverJar fails every launch. Test scope does not reach the shade
			     plugin, so the jar this module publishes is unaffected. -->
			<groupId>com.microsoft.playwright</groupId>
			<artifactId>driver-bundle</artifactId>
			<version>${playwright.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.dbflute.utflute</groupId>
			<artifactId>utflute-lastaflute</artifactId>
			<version>${utflute.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
